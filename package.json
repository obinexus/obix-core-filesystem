{
  "name": "obix-core-filesystem",
  "version": "0.5.0",
  "description": "Project-root path resolution, byte/text reads, serialized safe writes and normalized watch invalidations with a polling fallback.",
  "license": "MIT",
  "author": "OBINexus Computing — Nnamdi Michael Okpala <okpalan@protonmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "LICENSE",
    "test",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "obix-core-capabilities": "0.5.0"
  },
  "keywords": [
    "obix",
    "obix-core",
    "compatibility",
    "host",
    "filesystem"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/obix-core-filesystem.git"
  },
  "bugs": {
    "url": "https://github.com/obinexus/obix-core-filesystem/issues"
  },
  "homepage": "https://github.com/obinexus/obix-core-filesystem#readme"
}
